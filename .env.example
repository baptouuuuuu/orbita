# Exporter ces variables dans le shell avant le lancement.
ORBITA_HOST=127.0.0.1
ORBITA_PORT=3000
ORBITA_ORIGIN=http://127.0.0.1:3000
ORBITA_DB=./data/orbita.sqlite
ORBITA_SILENT_SECONDS=60
# ORBITA_ADMIN_PASSWORD et ORBITA_GM_PASSWORD sont obligatoires (12 caractères minimum).
